# Environment Variables Template
# Copy this file to .env and set your GCP project before running locally.

# --- AI Configuration (Claude on Vertex AI) ---
# GCP project with access to the models in ai_models.json
ANTHROPIC_VERTEX_PROJECT_ID="your-google-cloud-project"
# Vertex AI region used by the scheduled workflow and both configured models
CLOUD_ML_REGION="us-east5"
# Models are configured separately in ai_models.json.
# Optional: use a different model configuration file.
# AI_MODEL_CONFIG="/path/to/ai_models.json"
# For local development: run gcloud auth application-default login.
# For GitHub Actions: set the GCP_SA_KEY repository secret, not a .env variable.

# --- GitHub API (optional for public repositories) ---
# Add a token for authenticated requests and higher rate limits.
# MY_GITHUB_TOKEN="your_github_token_here"

# --- Slack notifications (optional for local testing) ---
# Leave unset to preview the reports without sending them.
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/your/webhook/url"
